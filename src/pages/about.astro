---
import BaseLayout from '../layouts/BaseLayout.astro';
import { selectedWork, credentials, whyGrid } from '../data/about';
import { site } from '../config';
---

<BaseLayout
  title="About"
  description="Three decades in luxury hospitality law. Former partner at Mayer Brown, Gowlings and Squire Patton Boggs, now an independent specialist. The partner is the practice."
>
  <!-- HEADER + PORTRAIT -->
  <header class="about-head shell">
    <div class="about-head__grid">
      <div class="about-head__text">
        <p class="overline reveal"><span class="dash"></span> About · {site.practitioner}</p>
        <h1 class="display-hero reveal" style="margin-top:1.5rem; --reveal-delay:80ms">
          Thirty years<br />at the table.
        </h1>
        <p class="lede reveal" style="margin-top:1.75rem; --reveal-delay:160ms">
          A career spent on luxury hospitality agreements — first inside major international
          firms, now as an independent specialist by deliberate choice.
        </p>
      </div>
      <div class="about-head__media frame reveal" style="--reveal-delay:120ms">
        <!-- TODO: replace with a licensed portrait or architectural image. -->
        <img
          src="https://images.unsplash.com/photo-1497366754035-f200968a6e72?q=80&w=1100&auto=format&fit=crop"
          alt="A quiet, considered workspace in low light."
          loading="lazy"
          width="1100"
          height="1375"
        />
      </div>
    </div>
  </header>

  <!-- STORY -->
  <section class="section-rhythm shell hairline">
    <div class="editorial">
      <div class="lead">
        <p class="overline reveal"><span class="dash"></span> The Path</p>
        <h2 class="display-lg reveal" style="margin-top:1.5rem; --reveal-delay:80ms">
          From partner to practice.
        </h2>
      </div>
      <div class="body about-story">
        <p class="lede reveal">
          Close to thirty years in hospitality and real-estate law, including
          partnership-level roles at <strong>Mayer Brown</strong>, <strong>Gowlings</strong> and
          <strong>Squire Patton Boggs</strong>.
        </p>
        <p class="muted reveal" style="--reveal-delay:80ms">
          Those years were spent on the documents that define luxury hospitality — management
          agreements with the major operators, branded-residence structures, the M&amp;A built
          around hospitality assets, and the F&amp;B arrangements woven through them. The same
          agreements, the same brands, negotiated again and again until the patterns became
          instinct.
        </p>
        <p class="muted reveal" style="--reveal-delay:140ms">
          The move to independent practice was a choice about how the work should be delivered.
          A senior client facing a senior counterparty does not need a pyramid beneath the
          partner; they need the partner. This practice removes everything between the two — so
          the person with the experience is the person doing the work, on a fixed fee, from the
          first call to signing.
        </p>
      </div>
    </div>
  </section>

  <!-- MANIFESTO PULL-QUOTE -->
  <section class="manifesto">
    <div class="shell">
      <blockquote class="manifesto__quote reveal">
        <p>“The partner is the practice. No associates, no leverage, no churn — only the senior person who has negotiated these agreements before, on your side of the table.”</p>
        <footer class="overline">{site.practitioner}</footer>
      </blockquote>
    </div>
  </section>

  <!-- CREDENTIALS -->
  <section class="section-rhythm shell">
    <p class="overline reveal"><span class="dash"></span> Credentials</p>
    <div class="creds-grid">
      {
        credentials.map((c, i) => (
          <div class="creds-col reveal" style={`--reveal-delay:${i * 80}ms`}>
            <h3 class="creds-col__label overline">{c.label}</h3>
            <ul class="creds-col__items">
              {c.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <p class="creds-col__note muted">{c.note}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- SELECTED WORK -->
  <section class="section-rhythm shell hairline">
    <div class="editorial">
      <div class="lead">
        <p class="overline reveal"><span class="dash"></span> Selected Work</p>
        <h2 class="display-xl reveal" style="margin-top:1.5rem; --reveal-delay:80ms">
          Described in confidence.
        </h2>
      </div>
      <div class="body">
        <p class="muted measure reveal" style="--reveal-delay:120ms">
          Representative matters, anonymised. Specifics — parties, terms, jurisdictions —
          available, with references, on request.
        </p>
      </div>
    </div>

    <ol class="work-list">
      {
        selectedWork.map((w, i) => (
          <li class="work-row reveal" style={`--reveal-delay:${i * 80}ms`}>
            <span class="work-row__num overline">{w.num}</span>
            <div>
              <span class="work-row__label overline">{w.label}</span>
              <p class="work-row__text">{w.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="work-foot overline reveal">References available on request</p>
  </section>

  <!-- WHY THIS PERSON, NOT A FIRM -->
  <section class="section-rhythm shell hairline">
    <div class="editorial">
      <div class="lead">
        <p class="overline reveal"><span class="dash"></span> The Case</p>
        <h2 class="display-xl reveal" style="margin-top:1.5rem; --reveal-delay:80ms">
          Why this person,<br />not a firm.
        </h2>
      </div>
      <div class="body">
        <p class="muted measure reveal" style="--reveal-delay:120ms">
          Six reasons the independent model serves the senior client better.
        </p>
      </div>
    </div>

    <div class="why-grid">
      {
        whyGrid.map((w, i) => (
          <article class="why-card reveal" style={`--reveal-delay:${(i % 3) * 80}ms`}>
            <span class="why-card__num overline">{w.num}</span>
            <h3 class="why-card__title">{w.title}</h3>
            <p class="muted">{w.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="about-cta shell">
    <div class="about-cta__inner reveal">
      <p class="overline"><span class="dash"></span> Enquiries</p>
      <h2 class="display-lg" style="margin:1.25rem 0">Work directly with the senior person.</h2>
      <div class="about-cta__actions">
        <a href="/contact" class="btn">Start a Conversation <span class="arrow" aria-hidden="true">→</span></a>
        <a href={`mailto:${site.email}`} class="link-arrow">{site.email}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-head {
    padding-top: clamp(8rem, 16vw, 12rem);
    padding-bottom: clamp(2rem, 5vw, 4rem);
  }
  .about-head__grid {
    display: grid;
    grid-template-columns: 7fr 4fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
  }
  .about-head__media {
    aspect-ratio: 4 / 5;
  }

  .about-story p + p {
    margin-top: 1.5rem;
  }
  .about-story strong {
    color: var(--color-bone);
    font-weight: 500;
  }

  /* MANIFESTO */
  .manifesto {
    padding-block: clamp(4rem, 10vw, 9rem);
    background: var(--color-ink-900);
    border-block: 1px solid var(--color-line);
  }
  .manifesto__quote {
    max-width: 24ch;
    margin: 0 auto;
  }
  .manifesto__quote p {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 4.5vw, 3.4rem);
    line-height: 1.18;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .manifesto__quote footer {
    margin-top: 2rem;
    color: var(--color-brass-dim);
  }

  /* CREDENTIALS */
  .creds-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    margin-top: 2.5rem;
    background: var(--color-line);
    border: 1px solid var(--color-line);
  }
  .creds-col {
    background: var(--color-ink);
    padding: clamp(1.5rem, 2.5vw, 2.25rem);
    min-height: 16rem;
    display: flex;
    flex-direction: column;
  }
  .creds-col__label {
    color: var(--color-brass);
    margin-bottom: 1.5rem;
  }
  .creds-col__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .creds-col__items li {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-bone);
  }
  .creds-col__note {
    margin-top: auto;
    padding-top: 1.5rem;
    font-size: 0.82rem;
  }

  /* SELECTED WORK */
  .work-list {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }
  .work-row {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: clamp(1rem, 3vw, 3rem);
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--color-line);
  }
  .work-row__num {
    color: var(--color-brass);
  }
  .work-row__label {
    display: block;
    color: var(--color-bone-muted);
    margin-bottom: 0.75rem;
  }
  .work-row__text {
    max-width: 70ch;
    color: var(--color-bone-2);
  }
  .work-foot {
    margin-top: 1.75rem;
    color: var(--color-brass-dim);
  }

  /* WHY GRID */
  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    background: var(--color-line);
    border: 1px solid var(--color-line);
  }
  .why-card {
    background: var(--color-ink);
    padding: clamp(1.75rem, 2.8vw, 2.5rem);
    min-height: 15rem;
  }
  .why-card__num {
    color: var(--color-brass);
  }
  .why-card__title {
    font-size: clamp(1.2rem, 1.7vw, 1.45rem);
    margin: 1rem 0 0.85rem;
    line-height: 1.2;
  }
  .why-card p {
    font-size: 0.95rem;
  }

  /* CTA */
  .about-cta {
    padding-block: clamp(4rem, 9vw, 8rem);
  }
  .about-cta__inner {
    border: 1px solid var(--color-line);
    background: var(--color-ink-800);
    padding: clamp(2.5rem, 6vw, 5rem);
  }
  .about-cta__actions {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
  }

  @media (max-width: 980px) {
    .creds-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .why-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 860px) {
    .about-head__grid {
      grid-template-columns: 1fr;
    }
    .about-head__media {
      max-width: 22rem;
    }
    .work-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
  @media (max-width: 520px) {
    .creds-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
