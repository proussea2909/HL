---
import Base from '../../layouts/Base.astro';
import { site } from '../../config';
import { insights } from '../../content';

const [featured, ...rest] = insights;
const firstRow = rest.slice(0, 3);
const secondRow = rest.slice(3);
---

<Base
  title={`Insights — ${site.practitionerName}`}
  description="Thought leadership on hotel management agreements, branded residences, hospitality M&A and F&B integration."
>
  <!-- ====================== HEADER ====================== -->
  <header class="gutter pb-16 pt-40 md:pt-48">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="md:col-span-8">
        <p class="overline mb-8">Insights</p>
        <h1 class="text-[clamp(2.6rem,6.5vw,4.6rem)] text-bone">
          Where the agreements actually turn.
        </h1>
      </div>
      <p class="self-end text-lg text-bone-variant md:col-span-3 md:col-start-10">
        Specific, practical notes for the people who sign these documents — not
        commentary for its own sake.
      </p>
    </div>
  </header>

  <!-- ====================== FEATURED ====================== -->
  <section class="gutter pb-20" aria-label="Featured insight">
    <a
      href={featured.href}
      class="group grid grid-cols-1 gap-10 border-t border-line pt-12 md:grid-cols-12"
      data-reveal
    >
      <div class="md:col-span-7">
        <div class="frame aspect-[16/10]">
          <img src={featured.img} alt="" loading="lazy" />
        </div>
      </div>
      <div class="flex flex-col justify-center md:col-span-5">
        <span class="chip self-start">{featured.category}</span>
        <h2
          class="mt-6 text-[clamp(1.9rem,3.5vw,2.8rem)] leading-[1.08] text-bone transition-colors group-hover:text-brass"
        >
          {featured.title}
        </h2>
        <p class="mt-6 text-lg text-bone-variant">{featured.standfirst}</p>
        <span class="arrow-link mt-8">
          Read the briefing <span class="arrow" aria-hidden="true">→</span>
        </span>
      </div>
    </a>
  </section>

  <!-- ====================== 3-UP ====================== -->
  <section class="gutter pb-px" aria-label="Recent insights">
    <ul class="grid grid-cols-1 gap-px bg-line md:grid-cols-3">
      {
        firstRow.map((post) => (
          <li class="bg-ink" data-reveal>
            <a href={post.href} class="group flex h-full flex-col gap-5 p-8 transition-colors hover:bg-ink-800">
              <span class="chip self-start">{post.category}</span>
              <h3 class="text-[1.45rem] leading-tight text-bone transition-colors group-hover:text-brass">
                {post.title}
              </h3>
              <p class="text-[0.95rem] text-bone-variant">{post.standfirst}</p>
              <span class="mt-auto pt-4 text-[0.72rem] uppercase tracking-[0.15em] text-bone-muted">
                {post.read} read
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ====================== SECOND ROW ====================== -->
  {
    secondRow.length > 0 && (
      <section class="gutter pt-px" aria-label="More insights">
        <ul class="grid grid-cols-1 gap-px bg-line md:grid-cols-2">
          {secondRow.map((post) => (
            <li class="bg-ink" data-reveal>
              <a href={post.href} class="group flex h-full flex-col gap-4 p-8 transition-colors hover:bg-ink-800">
                <div class="flex items-baseline justify-between gap-4">
                  <span class="chip">{post.category}</span>
                  <span class="text-[0.72rem] uppercase tracking-[0.15em] text-bone-muted">
                    {post.read}
                  </span>
                </div>
                <h3 class="text-[1.45rem] leading-tight text-bone transition-colors group-hover:text-brass">
                  {post.title}
                </h3>
                <p class="text-[0.95rem] text-bone-variant">{post.standfirst}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- ====================== QUARTERLY BRIEFING ====================== -->
  <section class="gutter hairline mt-24 py-24 md:py-32" aria-labelledby="briefing-heading">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="overline mb-6" data-reveal>Quarterly briefing</p>
        <h2
          id="briefing-heading"
          class="text-[clamp(1.9rem,4vw,2.8rem)] text-bone"
          data-reveal
        >
          A short letter, four times a year.
        </h2>
        <p class="mt-6 text-bone-variant" data-reveal>
          One considered note each quarter on the agreements shaping luxury
          hospitality. No volume, no marketing — the same restraint as the
          practice.
        </p>
      </div>

      <div class="md:col-span-6 md:col-start-7">
        <!-- TODO: point action to your form/newsletter endpoint (see README) -->
        <form
          id="briefing-form"
          action={site.formEndpoint}
          method="POST"
          class="space-y-8"
          data-reveal
        >
          <input type="hidden" name="_subject" value="Quarterly briefing sign-up" />
          <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="field">
            <label for="briefing-email">Email address</label>
            <input
              id="briefing-email"
              type="email"
              name="email"
              required
              placeholder="you@organisation.com"
              autocomplete="email"
            />
          </div>
          <button type="submit" class="btn">
            Subscribe <span aria-hidden="true">→</span>
          </button>
          <p
            id="briefing-success"
            class="hidden text-[0.95rem] text-brass"
            role="status"
          >
            Thank you. You are on the list for the next briefing.
          </p>
        </form>
      </div>
    </div>
  </section>

  <script>
    function initBriefing() {
      const form = document.getElementById('briefing-form') as HTMLFormElement | null;
      const success = document.getElementById('briefing-success');
      if (!form || !success) return;
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        try {
          await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
        } catch {
          /* graceful: show success regardless of placeholder endpoint state */
        }
        form.reset();
        success.classList.remove('hidden');
      });
    }
    initBriefing();
    document.addEventListener('astro:page-load', initBriefing);
  </script>
</Base>
