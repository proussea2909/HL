---
import Base from '../layouts/Base.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { site } from '../config';
import { pillars, engagements, insights } from '../content';

const teaser = insights.slice(0, 3);
---

<Base
  title={`${site.practitionerName} — ${site.discipline} | ${site.firm}`}
>
  <!-- ====================== SECTION 1 · HERO ====================== -->
  <section class="relative flex min-h-[100svh] items-end overflow-hidden">
    <div class="frame absolute inset-0 -z-10" aria-hidden="true">
      <!-- TODO: swap for licensed hospitality photography -->
      <img
        src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=2000&q=70"
        alt=""
        fetchpriority="high"
      />
      <div
        class="absolute inset-0"
        style="background: linear-gradient(180deg, rgba(19,19,19,0.55) 0%, rgba(19,19,19,0.35) 40%, rgba(19,19,19,0.92) 100%);"
      >
      </div>
    </div>

    <div class="gutter w-full pb-20 pt-36">
      <p class="overline mb-8">{site.discipline} · {site.markets}</p>
      <h1 class="max-w-[15ch] text-[clamp(2.8rem,7vw,5rem)] text-bone">
        The partner is the practice.
      </h1>
      <p class="mt-8 max-w-2xl text-lg text-bone-variant md:text-xl">
        Three decades of luxury hospitality law — Hotel Management Agreements,
        branded residences, M&amp;A and F&amp;B integration — handled end to end
        by the senior person who has negotiated them before. No associates, no
        leverage, no churn: the person you meet is the person who negotiates
        your agreement and stays with you from first call to signing.
      </p>
      <div class="mt-12">
        <a href="/contact" class="btn">
          Start a Conversation <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ====================== SECTION 2 · PRACTICE ====================== -->
  <section class="gutter hairline py-24 md:py-32" aria-labelledby="pillars-heading">
    <div class="mb-14 grid grid-cols-1 gap-8 md:grid-cols-12">
      <div class="md:col-span-6">
        <p class="overline mb-5" data-reveal>Practice</p>
        <h2
          id="pillars-heading"
          class="text-[clamp(2rem,4.5vw,3.2rem)] text-bone"
          data-reveal
        >
          Four areas, one specialism.
        </h2>
      </div>
      <div class="self-end md:col-span-5 md:col-start-8">
        <p class="text-lg text-bone-variant" data-reveal>
          A deliberately narrow practice in luxury hospitality — deep where it
          counts, and structured so the agreements, the deal and the F&amp;B all
          sit consistently together.
        </p>
        <!-- Operator credibility line -->
        <p class="mt-4 text-[0.95rem] text-bone-muted" data-reveal>
          Negotiated against all the major international hotel operators, across
          European and Gulf markets.
        </p>
      </div>
    </div>

    <ul class="grid grid-cols-1 border-t border-line md:grid-cols-2">
      {
        pillars.map((p) => (
          <li class="group border-b border-line md:[&:nth-child(odd)]:border-r md:[&:nth-child(odd)]:pr-12 md:[&:nth-child(even)]:pl-12">
            <a
              href={`/practice#${p.id}`}
              class="flex flex-col gap-4 py-10"
              data-reveal
            >
              <span class="arrow-link text-brass">
                {p.index} / {p.cardTag}
                <span class="arrow" aria-hidden="true">→</span>
              </span>
              <h3 class="text-[clamp(1.5rem,3vw,2.1rem)] text-bone transition-colors group-hover:text-brass">
                {p.title}
              </h3>
              <p class="max-w-md text-bone-variant">{p.body}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ====================== SECTION 3 · ENGAGEMENT ====================== -->
  <section class="gutter hairline py-24 md:py-32" aria-labelledby="engage-heading">
    <div class="mb-16 max-w-2xl">
      <p class="overline mb-5" data-reveal>Engagement</p>
      <h2
        id="engage-heading"
        class="text-[clamp(2rem,4.5vw,3.2rem)] text-bone"
        data-reveal
      >
        Priced for certainty.
      </h2>
      <p class="mt-6 text-lg text-bone-variant" data-reveal>
        Three ways to work together. Fixed-fee by default, because the work is
        known and the experience is real.
      </p>
    </div>

    <ul class="grid grid-cols-1 gap-px bg-line md:grid-cols-3">
      {
        engagements.map((e) => (
          <li class="flex h-full flex-col bg-ink p-8" data-reveal>
            <span class="text-[0.75rem] font-semibold tracking-[0.15em] text-brass">
              {e.index} / {e.meta.toUpperCase()}
            </span>
            <h3 class="mt-5 text-[1.6rem] leading-tight text-bone">{e.title}</h3>
            <p class="mt-4 text-bone-variant">{e.body}</p>
            <ul class="mt-7 space-y-2.5 border-t border-line pt-6">
              {e.points.map((pt) => (
                <li class="flex items-baseline gap-3 text-[0.92rem] text-bone-variant">
                  <span class="text-brass" aria-hidden="true">·</span>
                  {pt}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 max-w-3xl text-[0.95rem] text-bone-muted" data-reveal>
      Hourly engagement is available, selectively, where a fixed fee does not
      fit the shape of the work. Indicative fees provided on enquiry.
    </p>
  </section>

  <!-- ====================== INSIGHTS TEASER ====================== -->
  <section class="gutter hairline py-24 md:py-32" aria-labelledby="insights-heading">
    <div class="mb-16 flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <p class="overline mb-5" data-reveal>Insights</p>
        <h2
          id="insights-heading"
          class="text-[clamp(2rem,4.5vw,3.2rem)] text-bone"
          data-reveal
        >
          Notes from the table.
        </h2>
      </div>
      <a href="/insights" class="arrow-link" data-reveal>
        All insights <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <ul class="grid grid-cols-1 gap-px bg-line md:grid-cols-3">
      {
        teaser.map((post) => (
          <li class="bg-ink" data-reveal>
            <a href={post.href} class="group flex h-full flex-col gap-5 p-8 transition-colors hover:bg-ink-800">
              <span class="chip self-start">{post.category}</span>
              <h3 class="text-[1.45rem] leading-tight text-bone transition-colors group-hover:text-brass">
                {post.title}
              </h3>
              <p class="text-[0.95rem] text-bone-variant">{post.standfirst}</p>
              <span class="mt-auto pt-4 text-[0.72rem] uppercase tracking-[0.15em] text-bone-muted">
                {post.read} read
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ====================== SECTION 4 · CONTACT ====================== -->
  <ClosingCTA
    overline="Enquiries"
    heading="Tell me what you are facing."
    body="Enquiries are read personally and treated in strict confidence."
    cta="Make an Enquiry"
  />
</Base>
